# Postgres connection string. On Render this is the Internal Database URL.
DATABASE_URL=

# Signs the session cookie. Use a long random string. Never commit a real value.
AUTH_SECRET=

# Set to 1 only for the one-time command that creates the first account.
# There is no public registration page.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Object storage. Use Cloudflare R2 or AWS S3 on Render. Do not point Render at the web service disk.
# OBJECT_STORE=disk writes files under OBJECT_DIR (local development).
# OBJECT_STORE=memory is for tests only. A restart forgets those files.
OBJECT_STORE=disk
OBJECT_DIR=./data/objects
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
