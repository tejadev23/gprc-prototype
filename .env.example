# Postgres. On Render, use the Internal Database URL from the linked Postgres instance.
DATABASE_URL=

# Object storage. Production (Render) must use Cloudflare R2 or AWS S3.
# Missing S3_* values fail uploads; production never writes to the web service disk.
OBJECT_STORE=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local development only. Do not set these on Render.
# OBJECT_STORE=disk
# OBJECT_DIR=./data/objects
# OBJECT_STORE=memory

# One-time account creation via `pnpm user:create`. Do not leave these on the web service.
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
# BOOTSTRAP_ALLOW_MORE=1
